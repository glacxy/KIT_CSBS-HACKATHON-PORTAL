PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nexus_hack
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
HACKATHON_ID=2026-nexus-hack
HACKATHON_NAME=Nexus Hack
MAX_TEAM_SIZE=5
# ISO-8601 timestamps with timezone, for example 2026-11-15T16:00:00+05:30
PROBLEM_SELECTION_DEADLINE=2026-11-14T12:00:00+05:30
SUBMISSION_DEADLINE=2026-11-15T14:00:00+05:30
SUBMISSION_EDITS_ALLOWED=true
ALLOW_PROBLEM_CHANGE=false
